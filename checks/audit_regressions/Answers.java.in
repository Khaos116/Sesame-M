import java.util.List;

public class AnswerCheck {
    static String response;
    String getAnswerStr(String text) { return response; }
@@ANSWER@@
    public static void main(String[] args) {
        AnswerCheck check = new AnswerCheck();
        response = "1.5m";
        assert check.getAnswer("distance?", List.of("15m", "1.5m")) == 1;
        response = "15m";
        assert check.getAnswer("distance?", List.of("1.5m", "15m")) == 1;
        response = "5m";
        assert check.getAnswer("distance?", List.of("m", "5m")) == 1;
        response = "possibly 1.5m or 15m";
        assert check.getAnswer("distance?", List.of("15m", "1.5m")) == -1;
        response = "";
        assert check.getAnswer("distance?", List.of("15m", "1.5m")) == -1;
        System.out.println("PASS decimal answer, exact match priority and ambiguous response rejection");
    }
}
