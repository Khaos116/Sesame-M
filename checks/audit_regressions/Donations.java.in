@@DONATIONS@@
    

static void run(boolean carbon, JSONObject data, List<Integer> expected) {
 calls.clear(); ProtectTreeRpcCall.response=new JSONObject().put("resultData",data).toString();
 if(carbon) carbonQueryActivity("a"); else marathonQueryActivity("a");
 assert calls.equals(expected) : calls;
}
public static void main(String[] args) {
 for(boolean carbon: new boolean[]{false,true}) {
  JSONObject data=new JSONObject().put("currentEnergy",5000).put("certLockStatus",false)
   .put("donateConfigVO",new JSONObject().put("donateNum",100).put("secondDonateMinNum",100));
  run(carbon,data,List.of(100));
  data.put("activityCertVO",new JSONObject().put("energy",0));
  run(carbon,data,List.of(100,900));
  donationSucceeds=false; run(carbon,data,List.of(100)); donationSucceeds=true;
  data.put("activityCertVO",new JSONObject()); run(carbon,data,List.of(100));
  data.remove("donateConfigVO"); run(carbon,data,List.of());
 }
 System.out.println("PASS donation cap, missing certificate/config and failed first donation (both activities)");
}}
