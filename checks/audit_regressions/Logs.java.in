import java.io.*;
import java.nio.file.*;
import java.text.*;
import java.util.*;

public class LogCheck {
    static String TAG = "test";
    static File MAIN_DIRECTORY_FILE, LOG_DIRECTORY_FILE;
    static class UserIdMap { static String uid; static String getCurrentUid() { return uid; } }
    // 账号目录名解析的桩：这里只验证 FileUtil 里的目录/发布/清理逻辑，名字解析本身见 check_account_folder.py
    static class AccountFolderName {
        static String resolve(String uid) { return isSafeFolder(uid) ? uid : "default"; }
        static boolean isSafeFolder(String n) { return n != null && n.matches("[A-Za-z0-9_-]{1,128}"); }
        static boolean isValidUid(String n) { return isSafeFolder(n); }
        static final Map<String, String> LABELS = new HashMap<>();
        static String displayLabel(String uid) { return LABELS.getOrDefault(uid, uid); }
    }
    static class AtomicConfigFile {
        static void write(String s, File f) throws IOException { Files.writeString(f.toPath(), s); }
    }
    static class Log {
        static ThreadLocal<SimpleDateFormat> DATE_FORMAT_THREAD_LOCAL = ThreadLocal.withInitial(() -> {
            SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd");
            f.setTimeZone(TimeZone.getTimeZone("GMT+8")); return f;
        });
        static String getLogFileName(String type) { return type + "." + DATE_FORMAT_THREAD_LOCAL.get().format(new Date()) + ".log"; }
        static void printStackTrace(String tag, Throwable t) { throw new AssertionError(t); }
    }
    static boolean copyTo(File from, File to) {
        try { Files.copy(from.toPath(), to.toPath(), StandardCopyOption.REPLACE_EXISTING); return true; }
        catch (IOException e) { return false; }
    }
    static boolean clearFile(File f) {
        try { Files.writeString(f.toPath(), ""); return true; }
        catch (IOException e) { throw new AssertionError(e); }
    }
@@LOGS@@
    public static void main(String[] args) throws Exception {
        MAIN_DIRECTORY_FILE = Files.createTempDirectory("log-check").toFile();
        LOG_DIRECTORY_FILE = new File(MAIN_DIRECTORY_FILE, "log"); LOG_DIRECTORY_FILE.mkdir();
        try {
            publishCurrentLogUser("A");
            UserIdMap.uid = null;
            assert getLogFile("runtime").getParentFile().getName().equals("A");
            UserIdMap.uid = "configB";
            assert getLogFile("runtime").getParentFile().getName().equals("A");
            publishCurrentLogUser("B");
            File current = getLogFile("runtime");
            assert current.getParentFile().getName().equals("B");
            File old = new File(getUserLogDirectory("A"), "runtime.2000-01-01.log");
            Files.writeString(old.toPath(), "old");
            Files.writeString(current.toPath(), "today");
            clearLog(); assert !old.exists(); assert current.length() == 5;
            try (RandomAccessFile out = new RandomAccessFile(current, "rw")) { out.setLength(104_857_600); }
            clearLog(); assert current.exists() && current.length() == 0;
            File a = new File(getUserLogDirectory("A"), Log.getLogFileName("runtime"));
            File other = new File(getUserLogDirectory("A"), Log.getLogFileName("forest"));
            Files.writeString(a.toPath(), "a"); Files.writeString(current.toPath(), "b");
            Files.writeString(other.toPath(), "keep"); clearLog("runtime");
            assert a.length() == 0 && current.length() == 0 && other.length() == 4;
            publishCurrentLogUser("../escape");
            assert getLogFile("runtime").getParentFile().getName().equals("default");
            // 导出文件名：账号名目录 → 带账号名；仍叫 uid 的目录 → 用账号名；default/目录外 → 原名
            AccountFolderName.LABELS.put("2088122949590991", "C158");
            File runtime = new File(new File(LOG_DIRECTORY_FILE, "C158"), "runtime.2026-09-21.log");
            assert exportName(runtime).equals("runtime.2026-09-21.C158.log") : exportName(runtime);
            File uidDir = new File(new File(LOG_DIRECTORY_FILE, "2088122949590991"), "runtime.2026-09-21.log");
            assert exportName(uidDir).equals("runtime.2026-09-21.C158.log") : exportName(uidDir);
            File noLabelDir = new File(new File(LOG_DIRECTORY_FILE, "2088000000000001"), "error.2026-09-21.log");
            assert exportName(noLabelDir).equals("error.2026-09-21.2088000000000001.log") : exportName(noLabelDir);
            File oldReport = new File(new File(LOG_DIRECTORY_FILE, "2088122949590991"), "rpc-failures.2026-09-21.2088122949590991.json");
            assert exportName(oldReport).equals("rpc-failures.2026-09-21.C158.json") : exportName(oldReport);
            File newReport = new File(new File(LOG_DIRECTORY_FILE, "C158"), "rpc-failures.2026-09-21.C158.json");
            assert exportName(newReport).equals("rpc-failures.2026-09-21.C158.json") : exportName(newReport);
            File defaultDir = new File(new File(LOG_DIRECTORY_FILE, "default"), "runtime.2026-09-21.log");
            assert exportName(defaultDir).equals("runtime.2026-09-21.log");
            assert exportName(new File(MAIN_DIRECTORY_FILE, "statistics.json")).equals("statistics.json");
            // 分享：接收方看到的是副本的文件名，必须带账号名，内容与原文件一致，且 shareDir 里只留这一份
            File shareDir = new File(MAIN_DIRECTORY_FILE, "share-cache");
            Files.createDirectories(runtime.getParentFile().toPath());
            Files.writeString(runtime.toPath(), "runtime body");
            File stale = new File(shareDir, "runtime.2026-09-20.C176.log");
            Files.createDirectories(shareDir.toPath()); Files.writeString(stale.toPath(), "stale");
            File shared = copyForShare(runtime, shareDir);
            assert shared != null && shared.getName().equals("runtime.2026-09-21.C158.log") : String.valueOf(shared);
            assert Files.readString(shared.toPath()).equals("runtime body");
            assert !stale.exists() && shareDir.list().length == 1 : "old shared copies must be cleaned";
            assert copyForShare(new File(MAIN_DIRECTORY_FILE, "missing.log"), shareDir) == null;
            System.out.println("PASS host log account, account cleanup, open-file truncation and path validation");
        } finally {
            try (var paths = Files.walk(MAIN_DIRECTORY_FILE.toPath())) {
                for (Path path : paths.sorted(Comparator.reverseOrder()).toList()) Files.delete(path);
            }
        }
    }
}
